[Unit]
Description=Watch files managed by monarchy-identity and repair them if overwritten

[Path]
PathChanged=/etc/pam.d/system-auth
PathChanged=/etc/pam.d/omarchy-lock-password
PathChanged=/etc/nsswitch.conf
PathChanged=/etc/sddm.conf.d
PathChanged=/etc/sudoers.d
Unit=monarchy-identity-reassert.service

[Install]
WantedBy=multi-user.target
