#!/bin/bash
# monarchy-identity: directory enrolment, login policy, posture reporting.
set -euo pipefail

ROOT="${MONARCHY_IDENTITY_ROOT:-/usr/share/monarchy-identity}"
[[ -d $ROOT/providers ]] || ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export OI_ROOT="$ROOT"
source "$ROOT/lib/common.sh"
source "$ROOT/lib/posture.sh"
CONF="$OI_CONF"

usage() {
  cat <<EOF
Usage: monarchy-identity <command>

  status [--json]            Show enrolment and posture
  enroll <provider> [args]   Enrol with a directory provider
  leave                      Unenrol and restore previous config
  check [--json]             Evaluate posture against /etc/monarchy-identity/policy.toml (exit 1 if non-compliant)
  confirm                    Cancel the pending auto-revert (after verifying login works; root)
  policy show|set [opts]     Show or change who may sign in (no re-join): --mode --groups --users --sudo-groups --offline-days
  reassert                   Re-apply managed /etc edits (run after updates; root)
  install-hooks              Install the post-update hook for the current user (not root)
  remove-hooks               Remove that hook
  install-widget [--enable]  Install the bar widget into ~/.config/omarchy/plugins (validated; not root)
  remove-widget              Remove it
  providers                  List available providers
EOF
}

json_escape() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '%s' "$s"; }

autologin_enabled() { [[ -n $(sddm_autologin_user) ]]; }

wheel_members() { getent group wheel | cut -d: -f4; }

cmd_status() {
  local json=0; [[ ${1:-} == --json ]] && json=1
  local provider mode enrolled=false autologin=false
  provider=$(conf_get provider local)
  mode=$(conf_get login_mode none)
  [[ $provider != local ]] && enrolled=true
  autologin_enabled && autologin=true
  local wheel; wheel=$(wheel_members)
  local details="" k v
  if [[ $enrolled == true && -x $ROOT/providers/$provider/status ]]; then
    while IFS='=' read -r k v; do details+="${details:+,}\"$k\":\"$(json_escape "$v")\""; done \
      < <("$ROOT/providers/$provider/status" 2>/dev/null)
  fi
  if ((json)); then
    local selfheal; selfheal=$(watch_active && echo true || echo false)
    printf '{"schema":1,"enrolled":%s,"provider":"%s","login_mode":"%s","autologin":%s,"revert_pending":%s,"self_heal":%s,"wheel_members":"%s","login_theme":"%s","username_field":%s,"details":{%s},' \
      "$enrolled" "$(json_escape "$provider")" "$(json_escape "$mode")" "$autologin" "$(revert_pending && echo true || echo false)" "$selfheal" "$(json_escape "$wheel")" "$(json_escape "$(sddm_theme_effective)")" "$([[ $(sddm_theme_effective) == "$IDENTITY_THEME" ]] && echo true || echo false)" "$details"
    printf '"device":{"hostname":"%s","os":"%s","omarchy":"%s","kernel":"%s"},' \
      "$(json_escape "$(uname -n)")" "$(json_escape "$(posture_os)")" "$(json_escape "$(posture_omarchy_version)")" "$(json_escape "$(uname -r)")"
    printf '"compliance":{"disk_encryption":"%s","firewall":"%s","secure_boot":"%s","tpm2":"%s","screen_lock_seconds":"%s","time_sync":"%s"}}\n' \
      "$(posture_disk_encryption)" "$(posture_firewall)" "$(posture_secure_boot)" "$(posture_tpm2)" "$(posture_screen_lock_seconds)" "$(posture_time_sync)"
  else
    echo "enrolled:      $enrolled"
    echo "provider:      $provider"
    echo "login mode:    $mode"
    echo "autologin:     $autologin"
    echo "wheel members: ${wheel:-none}"
    echo "disk encrypted: $(posture_disk_encryption)"
    echo "firewall:       $(posture_firewall)"
    echo "secure boot:    $(posture_secure_boot)"
    echo "tpm2:           $(posture_tpm2)"
    echo "time sync:      $(posture_time_sync)"
  fi
}

cmd_providers() { ls "$ROOT/providers"; }

run_provider() { # run_provider <provider> <action> [args]
  local p=$1 a=$2; shift 2
  local s="$ROOT/providers/$p/$a"
  [[ -x $s ]] || { echo "provider '$p' has no '$a'" >&2; exit 1; }
  "$s" "$@"
}

case "${1:-}" in enroll|leave|reassert|confirm|policy) [[ $EUID -eq 0 ]] && oi_lock ;; esac
case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  providers) cmd_providers ;;
  enroll) shift; [[ $# -ge 1 ]] || { usage; exit 1; }; p=$1; shift; run_provider "$p" enroll "$@" ;;
  install-hooks|remove-hooks)
    [[ $EUID -ne 0 ]] || { echo "run as the desktop user, not root (Omarchy hooks live in ~/.config/omarchy/hooks)" >&2; exit 1; }
    hook_name=10-monarchy-identity-reassert; hook_src="$ROOT/hooks/post-update.d/$hook_name"
    hook_dst="$HOME/.config/omarchy/hooks/post-update.d/$hook_name"
    if [[ $1 == install-hooks ]]; then
      [[ -f $hook_src ]] || { echo "hook source not found: $hook_src" >&2; exit 1; }
      if command -v omarchy >/dev/null 2>&1; then omarchy hook install post-update "$hook_src"   # Omarchy's own installer
      else install -D -m 0755 "$hook_src" "$hook_dst"; echo "installed $hook_dst"; fi
    else rm -f "$hook_dst"; echo "removed $hook_dst"; fi ;;
  check)
    shift; pol="${MONARCHY_IDENTITY_POLICY:-/etc/monarchy-identity/policy.toml}"
    [[ -r $pol ]] || { echo "no policy file at $pol (see docs/ADMIN.md)" >&2; exit 2; }
    cmd_status --json | python3 -I "$ROOT/lib/check.py" "$pol" "$@" ;;
  install-widget|remove-widget)
    [[ $EUID -ne 0 ]] || { echo "run as the desktop user, not root (Omarchy plugins live in ~/.config/omarchy/plugins)" >&2; exit 1; }
    wsrc="$ROOT/shell-plugin"; [[ -f $wsrc/manifest.json ]] || { echo "widget not found at $wsrc (install the monarchy-identity-shell package)" >&2; exit 1; }
    wid=$(python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1]))["id"])' "$wsrc/manifest.json")
    wdst="$HOME/.config/omarchy/plugins/$wid"
    if [[ $1 == remove-widget ]]; then
      if command -v omarchy >/dev/null 2>&1; then omarchy plugin disable "$wid" >/dev/null 2>&1 || true; fi
      rm -rf "$wdst"; echo "removed $wid"
    else
      if command -v omarchy >/dev/null 2>&1; then omarchy plugin validate "$wsrc" || exit 1; fi   # refuse what the shell would reject
      rm -rf "$wdst"; install -d "$wdst"
      for f in manifest.json Panel.qml Model.js README.md; do [[ -f $wsrc/$f ]] && install -m 0644 "$wsrc/$f" "$wdst/$f"; done
      echo "installed $wid -> $wdst"
      if [[ ${2:-} == --enable ]]; then omarchy plugin enable "$wid" --section right; else echo "enable it with: omarchy plugin enable $wid --section right"; fi
    fi ;;
  confirm) [[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 1; }; if revert_pending; then revert_cancel; log "enrolment confirmed; auto-revert cancelled"; else echo "no auto-revert pending"; fi ;;
  policy) shift; run_provider "$(conf_get provider local)" policy "$@" ;;
  reassert) run_provider "$(conf_get provider local)" reassert ;;
  leave) shift; run_provider "$(conf_get provider local)" unenroll "$@" ;;
  -h|--help|"") usage ;;
  *) usage; exit 1 ;;
esac
