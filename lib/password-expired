#!/usr/bin/python3 -I
"""Lets a person whose directory password must be changed past the login screen, to change it before the desktop.

SDDM never asks for a new password: it treats the directory's "new password required" as a failed sign-in. pamedit.py
(greeter) runs this from SDDM's PAM service with pam_exec, twice per sign-in:
  auth (expose_authtok, after the real password check): asks the directory again, with the password that check just
      accepted, whether it must be changed, and marks this sign-in if so. Never changes the auth result. sssd only says
      a password expired within the handle that authenticated, so the account phase can't ask on its own.
  account: exit 0 iff this sign-in was just marked (the stack then ends, successfully); else 1 (ignored: the normal
      account checks run).
  pending USER: same answer, for the session command (lib/sddm-session), which shows the change-password screen.
The re-check uses the monarchy-identity-expired PAM service (the provider's module only; the core writes it).
SDDM reads its config once, at start: a sign-in is only let through while the running SDDM uses our session command,
or the person would reach the desktop without changing the password.
"""
import ctypes
import ctypes.util
import os
import sys
import time

MARKS = os.environ.get("MONARCHY_IDENTITY_MARKS", "/run/monarchy-identity/password-change") if os.getuid() else \
    "/run/monarchy-identity/password-change"
SERVICE = b"monarchy-identity-expired"
SESSION_CONF = "/etc/sddm.conf.d/zz-monarchy-identity-session.conf"   # lib/common.sh writes it
FRESH = 120   # seconds: a mark only counts for the sign-in that made it
PAM_NEW_AUTHTOK_REQD = 12


def mark_of(user):
    if not user or "/" in user or user.startswith("."):
        sys.exit(1)
    return os.path.join(MARKS, user)


def pending(mark):
    try:
        return time.time() - os.stat(mark).st_mtime < FRESH
    except OSError:
        return False


def session_command_live():
    """True iff the SDDM serving this sign-in (our parent's parent: pam_exec <- sddm-helper <- sddm) started after
    SESSION_CONF was written."""
    def stat(pid):   # the fields after "(comm)": [1] is the parent, [19] the start time in clock ticks after boot
        with open(f"/proc/{pid}/stat") as f:
            return f.read().rsplit(")", 1)[1].split()
    try:
        sddm = stat(os.getppid())[1]
        with open("/proc/uptime") as f:   # its age, to the clock tick (boot time in /proc/stat is whole seconds)
            age = float(f.read().split()[0]) - int(stat(sddm)[19]) / os.sysconf("SC_CLK_TCK")
        return time.time() - age >= os.stat(SESSION_CONF).st_mtime
    except (OSError, ValueError, IndexError):
        return False


def must_change(user, password):
    """Authenticates USER with PASSWORD through SERVICE; True iff the directory says the password must be changed."""
    libpam = ctypes.CDLL(ctypes.util.find_library("pam"))
    libc = ctypes.CDLL(ctypes.util.find_library("c"))
    libc.calloc.restype = ctypes.c_void_p
    libc.strdup.restype = ctypes.c_void_p

    class Msg(ctypes.Structure):
        _fields_ = [("style", ctypes.c_int), ("msg", ctypes.c_char_p)]

    class Resp(ctypes.Structure):
        _fields_ = [("resp", ctypes.c_void_p), ("retcode", ctypes.c_int)]

    CONV = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.POINTER(Msg)),
                            ctypes.POINTER(ctypes.POINTER(Resp)), ctypes.c_void_p)

    def conv(n, msgs, resp, _):   # answers every hidden prompt with the password; PAM frees what we allocate
        arr = ctypes.cast(libc.calloc(n, ctypes.sizeof(Resp)), ctypes.POINTER(Resp))
        for i in range(n):
            if msgs[i].contents.style == 1:   # PAM_PROMPT_ECHO_OFF
                arr[i].resp = libc.strdup(password)
        resp[0] = arr
        return 0

    class Conv(ctypes.Structure):
        _fields_ = [("conv", CONV), ("data", ctypes.c_void_p)]

    libpam.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(Conv), ctypes.POINTER(ctypes.c_void_p)]
    libpam.pam_authenticate.argtypes = libpam.pam_acct_mgmt.argtypes = [ctypes.c_void_p, ctypes.c_int]
    libpam.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]
    c, h = Conv(CONV(conv), None), ctypes.c_void_p()
    if libpam.pam_start(SERVICE, user.encode(), ctypes.byref(c), ctypes.byref(h)):
        return False
    rc = libpam.pam_authenticate(h, 0)
    if rc == 0:
        rc = libpam.pam_acct_mgmt(h, 0)
    libpam.pam_end(h, rc)
    return rc == PAM_NEW_AUTHTOK_REQD


def main():
    if sys.argv[1:2] == ["pending"] and len(sys.argv) == 3:
        sys.exit(0 if pending(mark_of(sys.argv[2])) else 1)
    mark = mark_of(os.environ.get("PAM_USER", ""))
    phase = os.environ.get("PAM_TYPE", "")
    if phase == "account":
        sys.exit(0 if pending(mark) else 1)
    if phase != "auth" or os.getuid():
        sys.exit(1)
    try:   # first, so a failure below can never leave an old mark standing
        os.unlink(mark)
    except FileNotFoundError:
        pass
    password = sys.stdin.buffer.read().split(b"\0")[0]
    if password and session_command_live() and must_change(os.environ["PAM_USER"], password):
        os.makedirs(MARKS, mode=0o755, exist_ok=True)
        with open(mark, "w"):
            pass
    sys.exit(0)


if __name__ == "__main__":
    main()
