#!/usr/bin/python3 -I
"""Signs a person in at the login screen when the directory can ask for more than a password (an authenticator code,
a number to approve on the phone), asking the directory only once per attempt.

SDDM answers every PAM prompt with the one password it collected, and its greeter can't answer anything else; a
module that restarts after a refusal (pam_himmelblau) would then send that password to the directory forever: as the
code, or again after a typo. pamedit.py (login-steps) runs this from SDDM's PAM service with pam_exec, ahead of the
normal stack. It signs in through its own PAM service (the provider's module alone) with what SDDM gave: the password,
or, from our theme's extra fields, up to three lines: the password, the code, a new password.
  auth (expose_authtok, stdout): answers the first prompt with the password, the module's new-password prompts (a
      password that must be changed) with the new password, and anything else once with the code.
      Signed in: exit 0 (the auth stack ends there, successfully; the account stack still decides who may sign in).
      Refused (the password asked again, a code or a new password asked for and none given, or a new password not
      accepted): marks this sign-in, exit 1. For something wanted it first prints the directory's message and then
      CODE_WANTED or NEW_PASSWORD_WANTED: pam_exec passes both to the login screen, and the theme shows the fields; a
      new password not accepted prints why. PASSWORD_CHANGED: the new password was accepted (the theme uses it from
      then on). Anything else (a local account, the daemon down): exit 1, the normal stack decides.
      A message the module leaves standing (the number to approve on the phone, while it waits) is printed too.
  auth, `refused`: exit 0 iff this sign-in was just refused (the stack then fails at once, without asking again).
"""
import ctypes
import ctypes.util
import os
import sys
import threading
import time

MARKS = "/run/monarchy-identity/login-steps"
SERVICE = b"monarchy-identity-login-steps"
CODE_WANTED = "monarchy-identity: code wanted"   # sddm-theme/monarchy-identity/Main.qml shows its code field
NEW_PASSWORD_WANTED = "monarchy-identity: new password wanted"   # ... and its new-password fields
PASSWORD_CHANGED = "monarchy-identity: password changed"   # ... and then signs in with the new one
# pam_himmelblau's prompts for a password Entra says must be changed (it changes it, then goes on signing in). Matched
# by text, so the module speaks English to us (LC_ALL in main); what the person reads comes from the daemon.
NEW_PROMPTS = ("New password:", "Confirm password:")
NOT_A_REASON = ("Changing the password. Please wait...",)
FRESH = 120   # seconds: a mark only counts for the sign-in that made it
WAITING = 3   # seconds a message stands with nothing asked after it: the module is waiting (a push to approve)
PAM_ABORT = 26
PAM_CONV_ERR = 19


OUT = None   # what pam_exec hands the login screen (stdout until main() moves it aside: the module logs to fd 1)


def say(text):
    print(" ".join(text.split()), file=OUT or sys.stdout, flush=True)


def local_account(user):
    """True iff USER is in /etc/passwd (as lib/password-expired: the system-auth edit skips the directory for them)."""
    try:
        with open("/etc/passwd") as f:
            return any(ln.split(":", 1)[0] == user for ln in f)
    except OSError:
        return True   # can't tell: don't let the directory decide


def sign_in(user, answer):
    """pam_authenticate for USER through SERVICE. ANSWER(n, style, text) returns the reply to the nth prompt, or None
    to end the conversation; it also sees the messages (n is then the number of prompts so far). Returns the result."""
    libpam = ctypes.CDLL(ctypes.util.find_library("pam"))
    libc = ctypes.CDLL(ctypes.util.find_library("c"))
    libc.calloc.restype = ctypes.c_void_p
    libc.strdup.restype = ctypes.c_void_p

    class Msg(ctypes.Structure):
        _fields_ = [("style", ctypes.c_int), ("msg", ctypes.c_char_p)]

    class Resp(ctypes.Structure):
        _fields_ = [("resp", ctypes.c_void_p), ("retcode", ctypes.c_int)]

    CONV = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.POINTER(Msg)),
                            ctypes.POINTER(ctypes.POINTER(Resp)), ctypes.c_void_p)
    prompts = [0]

    def conv(n, msgs, resp, _):   # PAM frees what we allocate
        arr = ctypes.cast(libc.calloc(n, ctypes.sizeof(Resp)), ctypes.POINTER(Resp))
        resp[0] = arr
        for i in range(n):
            style, text = msgs[i].contents.style, (msgs[i].contents.msg or b"").decode(errors="replace")
            reply = answer(prompts[0], style, text)
            if style in (1, 2):   # PAM_PROMPT_ECHO_OFF / ON
                prompts[0] += 1
                if reply is None:
                    return PAM_CONV_ERR
                arr[i].resp = libc.strdup(reply.encode())
        return 0

    class Conv(ctypes.Structure):
        _fields_ = [("conv", CONV), ("data", ctypes.c_void_p)]

    libpam.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(Conv), ctypes.POINTER(ctypes.c_void_p)]
    libpam.pam_authenticate.argtypes = [ctypes.c_void_p, ctypes.c_int]
    libpam.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]
    c, h = Conv(CONV(conv), None), ctypes.c_void_p()
    if libpam.pam_start(SERVICE, user.encode(), ctypes.byref(c), ctypes.byref(h)):
        return -1
    rc = libpam.pam_authenticate(h, 0)
    libpam.pam_end(h, rc)
    return rc


def once(user, password, code, new=""):
    """Signs USER in: the first prompt gets PASSWORD, new-password prompts NEW, another, different one CODE. 'ok',
    'refused', 'code' or 'new' (a code or a new password was asked for and none given; nothing was sent for it), or None
    (no answer either way). Prints PASSWORD_CHANGED when the module goes on past the new password (it has taken it)."""
    timers = []

    def cancel():
        while timers:
            timers.pop().cancel()
    changed, spent = [], []
    for _ in (1, 2):
        first, seen, last, since, asked = [], [], [], [], {}

        def answer(n, style, text):
            cancel()
            if style not in (1, 2):
                if first and text.strip():
                    last[:] = [text]
                    since.append(text)
                    timers.append(threading.Timer(WAITING, say, (text,)))
                    timers[-1].start()
                return None
            told, since[:] = list(since), []
            if n == 0:
                first.append(text)
                return password
            prompt = text.strip()
            if prompt in NEW_PROMPTS:
                asked[prompt] = asked.get(prompt, 0) + 1
                if asked[prompt] == 1 and prompt == NEW_PROMPTS[0]:
                    asked["banner"] = told[-1:]
                if asked[prompt] > 1:   # asked again: the new password wasn't accepted; the message just before says why
                    why = [m for m in told if m not in asked["banner"] and m.strip() not in NOT_A_REASON]
                    if why:
                        say(why[-1])
                    seen.append("refused")
                    return None
                if new:
                    return new
                seen.append("new")
                if last:
                    say(last[0])
                say(NEW_PASSWORD_WANTED)
                return None
            if asked.get(NEW_PROMPTS[1]) and not changed:   # past the new password: the directory took it
                changed.append(True)
                say(PASSWORD_CHANGED)
                asked.pop("code", None)   # the module signs in again with the new one: a code may be asked again
            if text == first[0] or asked.get("code"):   # asked again: the directory refused what it got
                seen.append("refused")
                return None
            asked["code"] = 1
            if code and not spent:   # a code is good for one sign-in
                spent.append(True)
                return code
            seen.append("code")
            if last:
                say(last[0])
            say(CODE_WANTED)
            return None
        rc = sign_in(user, answer)
        cancel()
        if rc == 0:
            return "ok"
        if seen:
            return seen[0]
        # A module that learns the directory is unreachable aborts once, then answers from its cache when asked again
        # (not after a new password was sent: the directory may have it, and the old one would be sent again)
        if rc != PAM_ABORT or asked.get(NEW_PROMPTS[1]):
            return None
    return None


def main():
    user = os.environ.get("PAM_USER", "")
    if not user or "/" in user or user.startswith(".") or os.environ.get("PAM_TYPE") != "auth" or os.getuid():
        sys.exit(1)
    mark = os.path.join(MARKS, user)
    if sys.argv[1:] == ["refused"]:
        try:
            refused = time.time() - os.stat(mark).st_mtime < FRESH
            os.unlink(mark)
        except OSError:
            refused = False
        sys.exit(0 if refused else 1)
    try:   # first, so a failure below can never leave an old mark standing
        os.unlink(mark)
    except FileNotFoundError:
        pass
    secret = sys.stdin.buffer.read().split(b"\0")[0].decode(errors="replace")
    password, code, new = (secret.split("\n", 2) + ["", ""])[:3]   # our theme's fields: password, code, new password
    if not password or local_account(user):
        sys.exit(1)
    os.environ["LC_ALL"] = "C.UTF-8"   # the module's prompts in English (NEW_PROMPTS); set before it loads
    global OUT   # the module's own log lines ("PAM conversation failed: PAM_CONV_ERR") are not for the person at the screen
    OUT = os.fdopen(os.dup(1), "w")
    os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
    outcome = once(user, password, code.strip(), new)
    if outcome in ("refused", "code", "new"):
        os.makedirs(MARKS, mode=0o755, exist_ok=True)
        open(mark, "w").close()
    sys.exit(0 if outcome == "ok" else 1)


if __name__ == "__main__":
    main()
