#!/usr/bin/python3 -I
"""Lets a person whose directory wants a second sign-in step (an authenticator code) past the login screen, to give it
before the desktop; and asks the directory only once per sign-in, so a wrong password isn't sent again and again.

SDDM answers every PAM prompt with the password it collected and can't ask anything else, and a module that restarts
after a refusal (pam_himmelblau) then sends that password to the directory forever: as the code, or again after a
typo. pamedit.py (second-step) runs this from SDDM's PAM service with pam_exec, ahead of the normal stack:
  auth (expose_authtok): signs in through its own PAM service (the provider's module alone) with the password SDDM
      gave, answering the first prompt only. Signed in: exit 0 (the auth stack ends there, successfully). The module
      asks for something else (the second step): marks this sign-in pending, exit 0. It asks for the password again
      (refused): marks the sign-in refused, exit 1. Anything else (a local account, the daemon down): exit 1, and the
      normal stack decides as before.
  auth, `refused`: exit 0 iff this sign-in was just refused (the stack then fails at once, without asking again).
  account: exit 0 iff this sign-in is pending (the stack then ends, successfully: the directory can't answer for
      someone who hasn't finished signing in on this laptop; the second step checks it).
  pending USER: same answer, for the session command (lib/sddm-session), which shows the second-step screen.
  verify: run by that screen as the person: signs in again on the terminal, every step, and checks they may sign in.
      Exit 0 iff both succeed. A repeated first prompt (the module starting over after a refusal) ends it.
A sign-in is only let through pending while the running SDDM uses our session command, or the person would reach the
desktop without the second step; until SDDM restarts after enroll, it's refused instead.
"""
import ctypes
import ctypes.util
import getpass
import importlib.machinery
import importlib.util
import os
import pwd
import sys
import time

MARKS = os.environ.get("MONARCHY_IDENTITY_MARKS", "/run/monarchy-identity/second-step") if os.getuid() else \
    "/run/monarchy-identity/second-step"
SERVICE = b"monarchy-identity-second-step"
FRESH = 120   # seconds: a mark only counts for the sign-in that made it
PAM_ABORT = 26
PAM_CONV_ERR = 19

# password-expired's checks (who is local, whether SDDM runs our session command), shared rather than copied
sys.dont_write_bytecode = True
_loader = importlib.machinery.SourceFileLoader(
    "password_expired", os.path.join(os.path.dirname(os.path.realpath(__file__)), "password-expired"))
expired = importlib.util.module_from_spec(importlib.util.spec_from_loader(_loader.name, _loader))
_loader.exec_module(expired)


def mark_of(user):
    if not user or "/" in user or user.startswith("."):
        sys.exit(1)
    return os.path.join(MARKS, user)


def marked(mark, what):
    try:
        with open(mark) as f:
            return f.read().strip() == what and time.time() - os.fstat(f.fileno()).st_mtime < FRESH
    except OSError:
        return False


def sign_in(user, answer):
    """pam_authenticate + (if it worked and account is set) pam_acct_mgmt for USER through SERVICE. ANSWER(n, style,
    text) returns the reply to the nth prompt, or None to end the conversation. Returns the PAM result."""
    libpam = ctypes.CDLL(ctypes.util.find_library("pam"))
    libc = ctypes.CDLL(ctypes.util.find_library("c"))
    libc.calloc.restype = ctypes.c_void_p
    libc.strdup.restype = ctypes.c_void_p

    class Msg(ctypes.Structure):
        _fields_ = [("style", ctypes.c_int), ("msg", ctypes.c_char_p)]

    class Resp(ctypes.Structure):
        _fields_ = [("resp", ctypes.c_void_p), ("retcode", ctypes.c_int)]

    CONV = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.POINTER(Msg)),
                            ctypes.POINTER(ctypes.POINTER(Resp)), ctypes.c_void_p)
    prompts = [0]

    def conv(n, msgs, resp, _):   # PAM frees what we allocate
        arr = ctypes.cast(libc.calloc(n, ctypes.sizeof(Resp)), ctypes.POINTER(Resp))
        resp[0] = arr
        for i in range(n):
            style, text = msgs[i].contents.style, (msgs[i].contents.msg or b"").decode(errors="replace")
            try:
                reply = answer(prompts[0], style, text)
            except Exception:   # Ctrl+C or a closed terminal at the second-step screen
                reply = None
            if style in (1, 2):   # PAM_PROMPT_ECHO_OFF / ON
                prompts[0] += 1
                if reply is None:
                    return PAM_CONV_ERR
                arr[i].resp = libc.strdup(reply.encode())
        return 0

    class Conv(ctypes.Structure):
        _fields_ = [("conv", CONV), ("data", ctypes.c_void_p)]

    libpam.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.POINTER(Conv), ctypes.POINTER(ctypes.c_void_p)]
    libpam.pam_authenticate.argtypes = libpam.pam_acct_mgmt.argtypes = [ctypes.c_void_p, ctypes.c_int]
    libpam.pam_end.argtypes = [ctypes.c_void_p, ctypes.c_int]
    c, h = Conv(CONV(conv), None), ctypes.c_void_p()
    if libpam.pam_start(SERVICE, user.encode(), ctypes.byref(c), ctypes.byref(h)):
        return -1
    rc = libpam.pam_authenticate(h, 0)
    if rc == 0 and answer.account:
        rc = libpam.pam_acct_mgmt(h, 0)
    libpam.pam_end(h, rc)
    return rc


def once(user, password):
    """Signs USER in with PASSWORD, answering the first prompt only: 'ok', 'pending' (the module asked for something
    else: a second step), 'refused' (it asked for the password again) or None (no answer either way)."""
    for attempt in (1, 2):
        first, seen = [], []

        def answer(n, style, text):
            if style not in (1, 2):
                return None
            if n == 0:
                first.append(text)
                return password.decode(errors="replace")
            seen.append("refused" if text == first[0] else "pending")
            return None
        answer.account = False   # the login screen's own account stack decides who may sign in
        rc = sign_in(user, answer)
        if rc == 0:
            return "ok"
        if seen:
            return seen[0]
        # A module that learns the directory is unreachable aborts once, then answers from its cache when asked again
        if rc != PAM_ABORT:
            return None
    return None


def verify():
    """The second-step screen: the whole sign-in on the terminal, as the person running it. True iff it worked."""
    try:
        user = pwd.getpwuid(os.getuid()).pw_name
    except KeyError:   # himmelblau resolves a user by id only once they've signed in on the laptop; SDDM set $USER
        user = os.environ.get("USER", "")
    first = []

    def answer(n, style, text):
        if style in (3, 4):   # PAM_ERROR_MSG / PAM_TEXT_INFO
            print(text, flush=True)
            return None
        if n == 0:
            first.append(text)
        elif text == first[0]:   # the module starting over after a refusal: stop, the screen offers to try again
            return None
        return getpass.getpass(text) if style == 1 else input(text)
    answer.account = True
    return sign_in(user, answer) == 0


def main():
    if sys.argv[1:2] == ["pending"] and len(sys.argv) == 3:
        sys.exit(0 if marked(mark_of(sys.argv[2]), "pending") else 1)
    if sys.argv[1:] == ["verify"]:
        sys.exit(0 if verify() else 1)
    mark = mark_of(os.environ.get("PAM_USER", ""))
    phase = os.environ.get("PAM_TYPE", "")
    if phase == "account":
        sys.exit(0 if marked(mark, "pending") else 1)
    if phase != "auth" or os.getuid():
        sys.exit(1)
    if sys.argv[1:] == ["refused"]:
        refused = marked(mark, "refused")
        if refused:
            os.unlink(mark)
        sys.exit(0 if refused else 1)
    try:   # first, so a failure below can never leave an old mark standing
        os.unlink(mark)
    except FileNotFoundError:
        pass
    password = sys.stdin.buffer.read().split(b"\0")[0]
    user = os.environ["PAM_USER"]
    if not password or expired.local_account(user):
        sys.exit(1)
    outcome = once(user, password)
    if outcome == "pending" and not expired.session_command_live():
        outcome = "refused"
    if outcome in ("pending", "refused"):
        os.makedirs(MARKS, mode=0o755, exist_ok=True)
        with open(mark, "w") as f:
            f.write(outcome + "\n")
    sys.exit(0 if outcome in ("ok", "pending") else 1)


if __name__ == "__main__":
    main()
