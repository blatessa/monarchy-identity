#!/bin/bash
# Stand-in for samba's `net`. State: $STUB_STATE/joined; knobs: STUB_PW (the join password), STUB_GROUPS and
# STUB_COMPUTERS (comma lists the "directory" holds), STUB_DC_DOWN, STUB_NO_DNS (no DNS for the domain or the DC),
# STUB_JOIN_FAIL (samba's reason for refusing a join). Output shapes: docs/dev/findings.md.
echo "net $*" >> "$STUB_LOG"
if [[ ${1:-} == lookup && ${2:-} == ldap ]]; then [[ -z ${STUB_NO_DNS:-} ]] || exit 255; echo "10.0.0.1:389"; exit 0; fi
[[ ${1:-} == ads ]] || exit 1
sub=$2; shift 2
creds() { # the directory refuses a wrong password; a DC that is down refuses everything
  local p; IFS= read -r p || p=""
  local e="ads_startup_int: ads_connect_creds:" nols="No logon servers are currently available to service the logon request."
  if [[ -n ${STUB_NO_DNS:-} ]]; then [[ " $* " == *" -S "* ]] && echo "$e The object was not found." >&2 || echo "$e $nols" >&2; exit 255; fi
  [[ -z ${STUB_DC_DOWN:-} ]] || { echo "$e $nols" >&2; exit 255; }
  [[ $p == "${STUB_PW:-Passw0rd!Test}" ]] || { echo "Password for [CORP\\Administrator]:gensec_gse_client_prepare_ccache: Kinit for Administrator@CORP.TEST to access ldap/dc.corp.test failed: Preauthentication failed: NT_STATUS_LOGON_FAILURE" >&2
    echo "$e Invalid credentials" >&2; exit 255; }
}
has() { local x i=${1,,}; IFS=, read -ra l <<<"$2"; for x in "${l[@]}"; do [[ ${x,,} == "$i" ]] && return 0; done; return 1; }
case $sub in
  search)
    creds "$@"
    for f in "$@"; do [[ $f == \(* ]] && filter=$f; done
    if [[ $filter =~ sAMAccountName=([^\)]+)\)\)?$ ]]; then n=${BASH_REMATCH[1]}; fi
    if [[ $filter == *objectClass=group* ]] && has "$n" "${STUB_GROUPS:-}"; then
      printf '\nGot 1 replies\n\nsAMAccountName: %s\ndistinguishedName: CN=%s,CN=Users,DC=corp,DC=test\n\n' "$n" "$n"
    elif [[ $filter != *objectClass=group* ]] && has "${n%\$}" "${STUB_COMPUTERS:-}"; then
      printf '\nGot 1 replies\n\ndistinguishedName: CN=%s,CN=Computers,DC=corp,DC=test\n\n' "${n%\$}"
    else printf '\nGot 0 replies\n\n'; fi ;;
  join) creds "$@"; [[ -z ${STUB_JOIN_FAIL:-} ]] || { printf 'Password for [CORP\\Administrator]:\nFailed to join domain: %s\n' "$STUB_JOIN_FAIL" >&2; exit 255; }
    touch "$STUB_STATE/joined"; printf 'keytab\n' > "$MONARCHY_IDENTITY_ETC/krb5.keytab" ;;
  keytab) creds "$@"; printf 'keytab\n' > "$MONARCHY_IDENTITY_ETC/krb5.keytab" ;;
  lookup) printf 'Domain: corp.test\nPre-Win2k Domain: %s\n' "${STUB_NETBIOS:-CORP}" ;;
  testjoin) [[ -e $STUB_STATE/joined ]] ;;
  leave) [[ " $* " != *" -U "* ]] || creds "$@"; rm -f "$STUB_STATE/joined" ;;
  *) exit 1 ;;
esac
