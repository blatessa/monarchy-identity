#!/bin/bash
# Stub provider for test/unit/provider.sh: the provider contract (docs/dev/writing-a-provider.md) without a directory.
# Logs each call, with the arguments and the policy the core passed, to $STUB_LOG.
set -euo pipefail
source "$OI_ROOT/lib/common.sh"
called() { echo "stub $* | ${OI_LOGIN_MODE-}|${OI_GROUPS-}|${OI_USERS-}|${OI_OFFLINE_DAYS-}|${OI_ADMIN_PASSWORD_FILE-}" >> "$STUB_LOG"; }
called policy "$@"
case ${1:-} in
  show) echo "tenant:        $(conf_get tenant)" ;;
  apply) need_root; [[ -z ${STUB_REFUSE:-} ]] || die "the stub directory says no" ;;
  *) exit 1 ;;
esac
