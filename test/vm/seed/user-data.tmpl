#cloud-config
users:
  - name: tester
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [wheel]
    lock_passwd: false
    plain_text_passwd: tester
    ssh_authorized_keys: ["@SSH_PUBKEY@"]
ssh_pwauth: true
write_files:
  - path: /etc/hosts.d-oi
    content: |
      10.0.2.2 dc.corp.test dc corp.test
runcmd:
  - [sh, -c, "cat /etc/hosts.d-oi >> /etc/hosts"]
  - [pacman, -Sy, --noconfirm, --needed, sssd, krb5, samba, sudo, sddm, ttf-dejavu, xorg-xauth, rsync]
