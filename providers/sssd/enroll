#!/bin/bash
# omarchy-identity enroll sssd --realm CORP.TEST --server dc.corp.test --admin Administrator
#   (--server optional: omit to use DNS SRV discovery)
#   [--mode groups|assigned|any] [--groups a,b] [--users u1,u2] [--disable-autologin]
#   [--password-file FILE]      admin password from a 0600 file instead of stdin (or $OI_ADMIN_PASSWORD_FILE)
#   [--confirm-within MINUTES]  auto-leave unless `omarchy-identity confirm` is run in time
#   [--allow-no-local-fallback] skip the "a local user with a password must exist" safety check   (admin password on stdin)
set -euo pipefail
export OI_ROOT="${OI_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)}"
source "$OI_ROOT/providers/sssd/lib.sh"
need_root

pwfile="" confirm_within=0 allow_no_fallback=0 disable_autologin=0 realm="" server="" admin="Administrator" mode="groups" groups="" users=""
while [[ $# -gt 0 ]]; do case $1 in
  --realm) realm=$2; shift 2;; --server) server=$2; shift 2;; --admin) admin=$2; shift 2;;
  --mode) mode=$2; shift 2;; --groups) groups=$2; shift 2;; --users) users=$2; shift 2;; --disable-autologin) disable_autologin=1; shift;; --confirm-within) confirm_within=$2; shift 2;; --password-file) pwfile=$2; shift 2;; --allow-no-local-fallback) allow_no_fallback=1; shift;;
  *) die "unknown option $1";; esac; done
[[ -n $realm ]] || die "--realm is required (--server is optional: omit it to discover DCs through DNS)"
case $mode in
  groups)   [[ -n $groups ]] || die "--mode groups needs --groups (default is deny)";;
  assigned) [[ -n $users ]]  || die "--mode assigned needs --users";;
  any) ;; *) die "bad --mode";;
esac
for c in sssd net python3; do command -v $c >/dev/null || die "missing dependency: $c"; done
if ((!allow_no_fallback)); then
  fb=$(local_fallback_users | tr '\n' ' ')
  [[ -n $fb ]] || die "no local account with a usable password exists; if the directory breaks you would be locked out. Create one (or pass --allow-no-local-fallback)"
  log "local fallback accounts: $fb"
fi
read_admin_password "$pwfile"

server_args "$server"
d=$(realm_lc "$realm"); host=$(uname -n | cut -d. -f1); fqdn="$host.$d"

for f in "${MANAGED[@]}"; do backup_file "$f"; done
rollback() { log "enrol failed - rolling back"; "$OI_ROOT/providers/sssd/unenroll" --quiet || true; }
trap rollback ERR

log "writing kerberos/samba config"
write_krb5 "$realm" "$server"; write_smb "$realm"
log "joining $realm via net ads join"
# Join TWICE. On a brand-new computer account the first join yields a machine key sssd's ldap_child
# is rejected with ("Preauthentication failed") although `kinit -k` accepts it; a second join (password
# reset, as already happens for pre-existing accounts) fixes it. Verified in test/vm/e2e.sh.
for _ in 1 2; do
  printf '%s\n' "$pw" | net ads join "${SARGS[@]}" -U "$admin" --no-dns-updates >/dev/null
done
# Build the keytab with ADMIN credentials. `-P` (machine creds) produced keytabs the KDC rejected
# ("Preauthentication failed") on fresh accounts; -S is needed so samba can find the DC for kvno/salt.
rm -f "$ETC/krb5.keytab"   # join already wrote one; appending mixes kvnos and kinit picks a bad entry
printf '%s\n' "$pw" | net ads keytab create "${SARGS[@]}" -U "$admin" >/dev/null 2>&1 || die "could not create machine keytab"
nb=${host^^}; nb=${nb:0:15}   # samba netbios name
kinit -k "$nb\$@${realm^^}" 2>/dev/null || die "machine keytab does not authenticate (kvno mismatch?)"
kdestroy 2>/dev/null || true
pw=""
write_sssd "$realm" "$server" "$mode" "$groups" "$users" "$fqdn" "$nb"
systemctl enable --now sssd
nss_apply
# verify directory lookups work BEFORE touching PAM (never lock out on a broken directory)
timeout 60 bash -c "until getent group \"${groups%%,*}\" >/dev/null 2>&1 || [[ $mode != groups ]]; do sleep 1; done" || true
if [[ $mode == groups ]]; then probe=${groups%%,*}; getent group "$probe" >/dev/null || \
  die "group '$probe' not resolvable via sssd; refusing to modify PAM"; fi
pam_apply
((disable_autologin)) && sddm_autologin_disable
conf_write provider=sssd login_mode="$mode" realm="$realm" server="$server" groups="$groups" users="$users" autologin_disabled="$([[ $disable_autologin == 1 ]] && echo true || echo false)"
trap - ERR
watch_enable   # self-heal: root-owned path unit re-asserts our edits if anything overwrites them
((confirm_within > 0)) && { revert_schedule "$confirm_within"; log "AUTO-REVERT in ${confirm_within} min unless you run: omarchy-identity confirm"; }
log "enrolled in $realm (login mode: $mode)"
