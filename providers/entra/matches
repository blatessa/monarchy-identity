#!/bin/bash
# For `enroll --if-needed`: given the enroll options, print the tenant if it is the one this laptop is enrolled in
# (the core then only converges the policy); refuse a different one.
set -euo pipefail
export OI_ROOT="${OI_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)}"
source "$OI_ROOT/providers/entra/lib.sh"
tenant="" client_id=""
while [[ $# -gt 0 ]]; do case $1 in --tenant) tenant=${2:-};; --client-id) client_id=${2:-};; esac; shift; done
cur=$(state_get tenant "")
[[ ${cur,,} == "${tenant,,}" ]] || die "already enrolled in '$cur'; run 'monarchy-identity leave' before enrolling in '$tenant'"
[[ -z $client_id ]] || valid_client_id "$client_id" || die "invalid --client-id '$client_id'"
[[ -z $client_id ]] || state_set client_id="$client_id"   # a new app registration for later policy changes
echo "$cur"
