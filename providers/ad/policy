#!/bin/bash
# policy show: the AD lines of `monarchy-identity policy show` (the core prints who may sign in).
# policy apply: enforce the policy the core resolved ($OI_LOGIN_MODE, $OI_GROUPS, $OI_USERS, $OI_OFFLINE_DAYS) on an
# enrolled machine: no re-join, no directory credentials. Refuses a group sssd cannot resolve before writing anything.
set -euo pipefail
export OI_ROOT="${OI_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)}"
source "$OI_ROOT/providers/ad/lib.sh"

realm=$(state_get realm ""); server=$(state_get server ""); nb=$(state_get computer_name ""); ou=$(state_get ou "")

case ${1:-} in
  show) echo "realm:         $realm"; echo "computer:      $nb${ou:+ in $ou}" ;;
  apply)
    need_root
    mode=$OI_LOGIN_MODE groups=$OI_GROUPS users=$OI_USERS offline_days=$OI_OFFLINE_DAYS
    if [[ $mode == groups ]]; then   # sssd resolves groups whatever the current access rule is
      IFS=, read -ra gl <<<"$groups"
      for g in "${gl[@]}"; do getent group "$g" >/dev/null 2>&1 || die "the directory has no group named '$g' (or it cannot be reached); policy unchanged"; done
    fi
    d=$(realm_lc "$realm"); fqdn="${nb,,}.$d"
    write_sssd "$realm" "$server" "$mode" "$groups" "$users" "$fqdn" "$nb" "$offline_days"
    sssd_restart
    wait_sssd_online "$d" 30 || log "WARNING: sssd did not report online within 30s (directory unreachable?); policy is applied and will take effect when it reconnects"
    ;;
  *) die "usage: policy show|apply" ;;
esac
