#!/bin/bash
# Idempotently re-apply the AD side (nsswitch, sssd running); the core re-applies PAM, SDDM and sudoers.
set -euo pipefail
export OI_ROOT="${OI_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)}"
source "$OI_ROOT/providers/ad/lib.sh"
need_root
[[ -f $ETC/sssd/sssd.conf ]] || die "sssd.conf missing; machine needs re-enrollment"
nss_apply
systemctl is-active --quiet sssd || sssd_restart
