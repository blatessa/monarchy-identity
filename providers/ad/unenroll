#!/bin/bash
# Leave the directory and remove the AD side of enroll (the core has already removed PAM, SDDM and sudoers).
# --admin USER deletes the computer account with that account's password (stdin or the core's --password-file).
set -uo pipefail
export OI_ROOT="${OI_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)}"
source "$OI_ROOT/providers/ad/lib.sh"
need_root
server_args "$(conf_get server)"
admin=""
while [[ $# -gt 0 ]]; do case $1 in --admin) admin=$2; shift 2;; *) die "unknown option $1";; esac; done
nss_remove
systemctl disable --now sssd 2>/dev/null || true
if [[ -f $ETC/sssd/sssd.conf ]]; then
  if [[ -n $admin ]] && read_admin_password; then
    printf '%s\n' "$pw" | net ads leave "${SARGS[@]}" -U "$admin" >/dev/null 2>&1 || log "WARNING: could not delete computer account in directory"
  elif ! net ads leave "${SARGS[@]}" -P >/dev/null 2>&1; then
    log "WARNING: computer account left in the directory; have a directory admin remove it (or rerun: leave --admin USER, password on stdin)"
  fi
fi
remove_if_ours "$ETC/krb5.conf" "$ETC/samba/smb.conf" "$ETC/sssd/sssd.conf"
rm -f "$ETC/krb5.keytab"
sss=${MONARCHY_IDENTITY_SSS_DIR:-/var/lib/sss}   # overridable for tests
rm -rf "$sss"/db/* "$sss"/mc/* 2>/dev/null || true
